# Rename this file to .env and fill in your real values.
# NEVER commit the real .env file to git or paste it in chat.

# --- Telegram ---
# Get from @BotFather. You need TWO separate bots: one for students, one for admin.
STUDENT_BOT_TOKEN=your_student_bot_token_here
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Comma-separated Telegram numeric user IDs allowed to use the admin bot
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Claude / AI router ---
# Rotate this key since it was shared in a chat before you got this project.
ANTHROPIC_API_KEY=your_new_api_key_here
ANTHROPIC_BASE_URL=https://clauderouter.app
ANTHROPIC_MODEL=claude-opus-5

# --- Database ---
DB_PATH=./data/study_bot.sqlite3

# --- Bot personality ---
BOT_NAME=StudyBuddy Cambodia
